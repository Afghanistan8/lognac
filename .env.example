# Demo uses fictional patient records only. Never put real patient data in this app.
PORT=3000
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=
# EU Neatlogs projects use https://eu.ingest.neatlogs.com; leave blank for US.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# A live key enables the optional model planner. The validated clinical checks
# and clinician approval gates run identically without it.
ALLOWED_DEMO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# The report and due-time reminder can only go to ALLOWED_DEMO_EMAIL.
# Use a test mailbox. Do not send real patient information.
